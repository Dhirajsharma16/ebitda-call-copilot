# AI EBITDA Cold Call Copilot - Backend Environment Configuration

# Service Port
PORT=8000
ENVIRONMENT=production

# Groq LLM API Configuration (Get free API key at https://console.groq.com)
# Suggested free models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase PostgreSQL Configuration (Get credentials at https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
# Use service role key if backend requires privileged bypass of RLS, or anon key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_anon_key

# Frontend CORS Origin (for deployed Vercel URL e.g. https://your-copilot.vercel.app or * for testing)
FRONTEND_ORIGIN=*
