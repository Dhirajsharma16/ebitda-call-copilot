# AI EBITDA Cold Call Copilot - Backend Environment Configuration

# Service Port
PORT=8000
ENVIRONMENT=production

# Google Gemini AI Configuration (Get key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq LLM API Configuration (Optional secondary provider: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase PostgreSQL Configuration (Get credentials at https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=

# Frontend CORS Origin (e.g. https://your-app.vercel.app or * for all)
FRONTEND_ORIGIN=*
